{
  "name": "missive",
  "version": "1.0.0",
  "description": "Correspondance privée sous forme de lettres",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "typecheck": "tsc -p tsconfig.public.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -p tsconfig.public.json && tsc -p tsconfig.server.json && node --check server.js && node --check public/app.js && node -e \"for (const file of ['public/index.html', 'public/correspondence.html', 'public/styles.css']) require('node:fs').accessSync(file)\""
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxou-cpu/missive.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/maxou-cpu/missive/issues"
  },
  "homepage": "https://github.com/maxou-cpu/missive#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
